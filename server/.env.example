# Copy this file to .env and fill in your own values. Never commit .env.
NODE_ENV=development
PORT=3000

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=grocer
DB_PASSWORD=your_password_here
DB_NAME=grocerydb

# Session secret: long random string (node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
SESSION_SECRET=replace_with_a_long_random_string

# HTTPS (optional): paths to your TLS key and certificate
# TLS_KEY=./certs/key.pem
# TLS_CERT=./certs/cert.pem

# Optional integrations - add credentials only when enabling the corresponding service.
# Google Maps JavaScript + Places/Geocoding API (restrict browser key by domain in production)
GOOGLE_MAPS_API_KEY=
# Google OAuth (not yet wired in this starter update)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Email delivery for OTP and transactional notifications (not yet wired in this starter update)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=FreshCart <customerservices@freshcart.co.ke>
# Paystack test/live credentials (not yet wired in this starter update)
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
PAYSTACK_CALLBACK_URL=
